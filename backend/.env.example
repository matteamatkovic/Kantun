# Kopiraj ovaj file u .env i popuni svojim podacima (isti kao u HeidiSQL-u)

# --- Baza podataka (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tvoja_baza
DB_USER=tvoje_korisnicko_ime
DB_PASSWORD=tvoja_lozinka

# --- Server ---
PORT=4000

# --- Autentikacija ---
JWT_SECRET=promijeni-ovo-u-jaku-tajnu-vrijednost
JWT_EXPIRES_IN=7d

# --- CORS (adresa na kojoj radi frontend) ---
FRONTEND_URL=http://localhost:9000
